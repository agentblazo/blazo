{
  "name": "@blazo/database",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Drizzle schema, migrations and SQLite client for Blazo.",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema.ts"
  },
  "types": "./src/index.ts",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "bun run src/migrate.ts"
  },
  "dependencies": {
    "@blazo/types": "workspace:*",
    "drizzle-orm": "^0.38.0"
  },
  "devDependencies": {
    "drizzle-kit": "^0.30.0"
  }
}
